# Set environment variables in your shell or hosting service. This file is NOT loaded automatically.
# Optional; when absent, a random secret is saved next to the database as secret.key.
# Generate your own secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE=instance/words.sqlite3
# Set to 1 behind HTTPS; use 0 only for local HTTP.
COOKIE_SECURE=0
HOST=127.0.0.1
PORT=8000
